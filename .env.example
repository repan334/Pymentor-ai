APP_NAME="PyMentor AI"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Pooled Neon URL for normal application traffic.
DATABASE_URL=
# Direct Neon URL for Alembic migrations and administrative operations.
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# The embedding model and vector dimension must be selected together in Phase 5.
EMBEDDING_MODEL=

SECRET_KEY=
MAX_UPLOAD_SIZE_MB=10
