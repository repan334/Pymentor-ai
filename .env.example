APP_NAME="PyMentor AI"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Pooled Neon URL for normal application traffic.
DATABASE_URL=
# Direct Neon URL for Alembic migrations and administrative operations.
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_PROMPT_VERSION=grounded-tutor-v1
CHAT_REQUEST_TIMEOUT_SECONDS=45
CHAT_MAX_ATTEMPTS=2
CHAT_RETRY_BASE_SECONDS=0.5
CHAT_MAX_QUESTION_CHARACTERS=2000
CHAT_MAX_DOCUMENT_IDS=100
CHAT_MAX_TOP_K=8
CHAT_MAX_CONTEXT_CHARACTERS=12000
CHAT_MAX_CONTEXT_CHUNK_CHARACTERS=4000
CHAT_MAX_OUTPUT_TOKENS=2048
CHAT_THINKING_BUDGET=512
CHAT_TEMPERATURE=0.2

# Phase 5 fixed retrieval profile. Keep the key only in .env/.env.local.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_INPUT_VERSION=retrieval-asymmetric-v1
GEMINI_API_KEY=
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BASE_SECONDS=0.5
EMBEDDING_BATCH_SIZE=16
MAX_INDEX_CHUNKS=200
MAX_INDEXING_SECONDS=120
INDEX_CLAIM_TIMEOUT_SECONDS=300
MAX_SEARCH_QUERY_CHARACTERS=2000
MAX_SEARCH_DOCUMENT_IDS=100

SECRET_KEY=
MAX_UPLOAD_SIZE_MB=10
MAX_MULTIPART_BODY_SIZE_MB=11
MAX_PDF_PAGES=200
MAX_EXTRACTED_CHARACTERS=2000000
INGESTION_CHUNK_SIZE=500
INGESTION_CHUNK_OVERLAP=100
